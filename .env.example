# ================= WallStreet Sentinel 環境變數 =================
# 複製為 .env 後填入。 .env 絕對不要上傳或貼到任何聊天室。

# --- Discord（必填）---
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# 你的伺服器 ID（填了斜線指令會立即出現；不填則全域同步，首次最久約 1 小時）
DISCORD_GUILD_ID=
# 推播頻道（也可以在 Discord 用 /setchannel 設定，免填）
ALERT_CHANNEL_ID=
BRIEFING_CHANNEL_ID=
# 你的 Discord 使用者 ID：CRITICAL 警報會私訊你
OWNER_USER_ID=

# --- AI 大腦：Claude 主、Gemini 備援 ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# 失敗時依序改用（逗號分隔）
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# 第三備援：OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_PRIMARY=claude

# --- 免費數據金鑰 ---
# FRED：https://fred.stlouisfed.org/docs/api/api_key.html （免費，30 秒申請）
FRED_API_KEY=
# SEC 規定需要聯絡資訊的 User-Agent
SEC_USER_AGENT=WallStreetSentinel your_email@example.com

# --- 持倉（沿用 sim_trading.json 的帳號 ID）---
PRIMARY_PORTFOLIO_USER_ID=
